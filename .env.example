# Browser requests stay same-origin; the React server proxies to this private API.
# Vercel injects this automatically from the frontend -> backend service binding.
# Set it manually only when using a separately hosted backend.
DORIS_API_BASE_URL=http://127.0.0.1:8788
DORIS_API_HOST=127.0.0.1
DORIS_API_PORT=8788
DASHBOARD_PORT=5173

# Apache Doris credentials are server-only. Never expose these as NEXT_PUBLIC_*.
DB_HOST=
DB_PORT=9030
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Docker Compose uses the sibling reporting checkout by default.
